FROM ros:humble-ros-base-jammy

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

RUN apt-get update -o Acquire::Retries=5 && \
    apt-get install -y --fix-missing --no-install-recommends \
    locales \
    curl \
    gnupg2 \
    lsb-release \
    sudo \
    git \
    vim \
    wget \
    software-properties-common \
    python3-pip \
    build-essential \
    ca-certificates \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    cmake \
    g++ \
    make \
    libasio-dev \
    libtinyxml2-dev \
    v4l-utils \
    usbutils \
    minicom \
    screen \
    picocom \
    net-tools \
    iproute2 \
    iputils-ping \
    udev \
    python3-opencv \
    libopencv-dev \
    ffmpeg \
    ros-humble-rmw-fastrtps-cpp \
    ros-humble-sensor-msgs \
    ros-humble-geometry-msgs \
    ros-humble-std-msgs \
    ros-humble-cv-bridge \
    ros-humble-image-transport \
    ros-humble-vision-msgs \
    ros-humble-tf2-ros \
    ros-humble-tf2-tools \
    ros-humble-tf-transformations \
    ros-humble-diagnostic-msgs \
    ros-humble-image-tools \
    ros-humble-realsense2-camera \
    ros-humble-realsense2-description \
    && rm -rf /var/lib/apt/lists/*

RUN locale-gen en_US en_US.UTF-8 || true
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

RUN rosdep init 2>/dev/null || true && rosdep update || true

RUN python3 -m pip install --upgrade pip

COPY jetson/requirements.jetson.txt /tmp/requirements.jetson.txt
RUN pip3 install --no-cache-dir --default-timeout=120 --retries 10 --ignore-installed -r /tmp/requirements.jetson.txt

RUN python3 -m pip install --no-cache-dir --force-reinstall "numpy==1.26.4"

WORKDIR /workspace/ros2

ENV PATH="/usr/local/bin:${PATH}"
ENV ROS_DOMAIN_ID=0
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ENV ROS_LOCALHOST_ONLY=0
ENV PYTHONUNBUFFERED=1

COPY ros2/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]

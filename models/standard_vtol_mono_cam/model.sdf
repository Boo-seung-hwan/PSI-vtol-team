<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='standard_vtol_mono_cam'>
    <include merge='true'>
      <uri>model://standard_vtol</uri>
    </include>

    <include merge='true'>
      <uri>model://mono_cam_vtol</uri>
      <pose>0.35 0 -0.05 0 0 0</pose>
    </include>

    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>mono_cam_vtol/base_link</child>
      <pose relative_to="base_link">0.35 0 -0.05 0 0 0</pose>
    </joint>
  </model>
</sdf>
